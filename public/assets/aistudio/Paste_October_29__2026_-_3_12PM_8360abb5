        function calculatePediatricDose() {
            const weight = parseFloat(document.getElementById('peds-weight').value);
            const drugId = document.getElementById('peds-drug-select').value;
            const outputBox = document.getElementById('pedsResultOutput');

            if (!weight || weight <= 0) {
                outputBox.style.display = 'none';
                return;
            }

            const drug = pediatricDrugsList.find(d => d.id === drugId);
            if (!drug) return;

            outputBox.style.display = 'block';
            let calculatedMg = (weight * drug.mgPerKg);
            if (drug.maxDoseMg && calculatedMg > drug.maxDoseMg) calculatedMg = drug.maxDoseMg;
            const calculatedMl = ((calculatedMg / drug.concMg) * drug.concMl).toFixed(1);

            outputBox.innerHTML = `
                <h4 style="color:#166534; font-size:1.05rem; margin-bottom:0.6rem;"><i class="fas fa-check-circle"></i> ${drug.name} (${weight} kg)</h4>
