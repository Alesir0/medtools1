            const total = parseInt(document.getElementById('calc-gcs-e').value) + parseInt(document.getElementById('calc-gcs-v').value) + parseInt(document.getElementById('calc-gcs-m').value);
            document.getElementById('gcsScoreVal').innerText = `${total} / 15`;
            const banner = document.getElementById('gcsResultBanner');
            if (total <= 8) {
                banner.className = "decision-banner decision-stop";
                document.getElementById('gcsActionText').innerText = "غيبوبة شديدة (GCS ≤ 8): تأمين مجرى التنفس والتنبيب الرغامي فوراً [ATLS].";
            } else {
                banner.className = "decision-banner decision-safe";
                document.getElementById('gcsActionText').innerText = "وعي معتدل أو طبيعي (GCS 9-15).";
            }
        }

        function runHeartCalculation() {
            const total = parseInt(document.getElementById('hs-h').value) + parseInt(document.getElementById('hs-e').value) + parseInt(document.getElementById('hs-a').value) + parseInt(document.getElementById('hs-r').value) + parseInt(document.getElementById('hs-t').value);
            document.getElementById('heartScoreVal').innerText = `${total} / 10`;
            const banner = document.getElementById('heartResultBanner');
            if (total <= 3) {
                banner.className = "decision-banner decision-safe";
                document.getElementById('heartActionText').innerText = "خطورة منخفضة (1.7% MACE risk). إمكانية التخريج الآمن مع المتابعة.";
            } else if (total <= 6) {
                banner.className = "decision-banner decision-caution";
                document.getElementById('heartActionText').innerText = "خطورة متوسطة (16.6% MACE risk). تنويم ومراقبة تخطيط وتروبونين.";
            } else {
                banner.className = "decision-banner decision-stop";
                document.getElementById('heartActionText').innerText = "خطورة عالية جداً (50-65% MACE risk)! قسطرة قلبية عاجلة ودخول CCU.";
            }
        }

        /* ========================================================
           9. عميل الذكاء الاصطناعي السريري التفاعلي بالصوت والربط
           ======================================================== */
        let recognition = null;
        let isRecording = false;

        function toggleAIPanel() {
            document.getElementById('aiPanel').classList.toggle('open');
        }

        function appendAIMessage(sender, htmlText) {
            const box = document.getElementById('aiChatBox');
            const msg = document.createElement('div');
            msg.className = `ai-msg ${sender}`;
            msg.innerHTML = htmlText;
            box.appendChild(msg);
            box.scrollTop = box.scrollHeight;
        }

        function toggleVoiceRecognition() {
            const btn = document.getElementById('aiVoiceBtn');
            const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;

            if (!SpeechRec) {
                alert("متصفحك لا يدعم خاصية التعرف على الصوت المباشرة. يرجى استخدام متصفح حديث كـ Chrome أو Edge.");
                return;
            }

            if (!recognition) {
                recognition = new SpeechRec();
                recognition.lang = 'ar-SA';
                recognition.interimResults = false;

                recognition.onstart = function() {
                    isRecording = true;
                    btn.classList.add('recording');
                    btn.innerHTML = '<i class="fas fa-stop"></i>';
                };

                recognition.onresult = function(event) {
                    const transcript = event.results[0][0].transcript;
                    document.getElementById('aiChatInput').value = transcript;
                    handleUserSendMessage();
                };

                recognition.onerror = function(event) {
                    btn.classList.remove('recording');
                    btn.innerHTML = '<i class="fas fa-microphone"></i>';
                    isRecording = false;
                };

                recognition.onend = function() {
                    btn.classList.remove('recording');
                    btn.innerHTML = '<i class="fas fa-microphone"></i>';
                    isRecording = false;
                };
            }

            if (isRecording) {
                recognition.stop();
            } else {
                recognition.start();
            }
        }

        function handlePatientContextChange() {
            const val = document.getElementById('aiSelectedPatient').value;
            if (val.startsWith("triage_")) {
                const id = parseInt(val.replace("triage_", ""));
                const p = erTriageList.find(x => x.id === id);
                if (p) appendAIMessage('bot', `سياق طوارئ محمل: <strong>${p.name}</strong> [${p.triageTitle}]<br>الشكوى: ${p.cc}<br>الضغط: ${p.bp} | النبض: ${p.hr} | SpO2: ${p.spo2}%<br>أنا جاهز لتقديم المشورة وتوجيه الفحوصات.`);
            } else if (val.startsWith("hd_")) {
                const id = parseInt(val.replace("hd_", ""));
                const p = hdPatientsList.find(x => x.id === id);
                if (p) appendAIMessage('bot', `سياق غسل كلوي محمل: <strong>${p.name}</strong><br>البوتاسيوم: ${p.k} mmol/L | احتباس سوائل: +${(p.preWeight - p.dryWeight).toFixed(1)} kg<br>الضغط: ${p.bp}<br>جاهز لمراجعة التحاليل وبروتوكول الجلسة.`);
            } else if (val !== 'none') {
                const p = patientsList.find(x => x.id == val);
                if (p) appendAIMessage('bot', `سياق ردهة محمل: <strong>${p.name}</strong> (${p.diagnosis})<br>الشكوى: ${p.cc}<br>الأدوية: ${p.medications}`);
            }
        }

        async function handleUserSendMessage() {
            const input = document.getElementById('aiChatInput');
            const text = input.value.trim();
            if (!text) return;
            appendAIMessage('user', text);
            input.value = '';

            // إذا كان المزود Gemini ومفتاح API موجود
            if (systemConfig.aiProvider === 'gemini' && systemConfig.geminiApiKey) {
                await callGeminiApi(text);
            } else {
                setTimeout(() => {
                    let reply = `أنا معك يا دكتور. قمت بمطابقة استفسارك مع أحدث المراجع السريرية العالمية (UpToDate • BNF • KDIGO).`;
                    const q = text.toLowerCase();

                    if (q.includes("أكتيليز") || q.includes("alteplase")) {
                        reply = `بخصوص مذيب التخثر <strong>Alteplase</strong>: تأكد أن الأعراض بدأت قبل أقل من 4.5 ساعة، ونفي النزيف الدماغي عبر CT Brain، وضبط ضغط الدم ليكون أقل من 185/110 mmHg. يمنع في حال وجود سوابق نزيف دماغي أو صفائح أقل من 100 ألف. <span class="source-tag">AHA/ASA</span>`;
                    } else if (q.includes("بوتاسيوم") || q.includes("غسل") || q.includes("كلوي")) {
                        reply = `في حال فرط البوتاسيوم الشديد (K+ > 6.5 mmol/L): يجب إعطاء <strong>Calcium Gluconate 10% (10ml IV)</strong> فوراً لحماية عضلة القلب قبل الشروع بوصل المريض للغسل، واستخدام حمام غسل منخفض البوتاسيوم. <span class="source-tag">KDIGO</span>`;
                    } else if (q.includes("ترياج") || q.includes("فرز")) {
                        reply = `نظام ESI يعتمد 5 مستويات: المستوى 1 إنعاش فوري مهدد للحياة، المستوى 2 حالات حرجة مثل اشتباه STEMI وسكتة، المستوى 3 يحتاج موارد متعددة لكنه مستقر حيوياً. <span class="source-tag">Emergency Triage</span>`;
                    } else if (q.includes("propranolol") || q.includes("ربو")) {
                        reply = `تحذير قاتل: حاصرات بيتا غير الانتقائية (Propranolol) تؤدي لتشنج قصبي حاد ومميت لدى مرضى الربو القصبي! <span class="source-tag">BNF Alert</span>`;
                    }

                    appendAIMessage('bot', reply);
                }, 400);
            }
        }

        async function callGeminiApi(userPrompt) {
            appendAIMessage('bot', '<em>جارٍ استشارة محرك Gemini API المباشر...</em>');
            const apiKey = systemConfig.geminiApiKey;
            const prompt = `You are an expert clinical MD medical assistant embedded in an emergency and hemodialysis hospital dashboard. Answer in clear, professional Arabic. Cite guidelines like UpToDate, BNF, KDIGO. Doctor's question: ${userPrompt}`;

            try {
                const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
                });
                const data = await res.json();
                const reply = data.candidates[0].content.parts[0].text;
                const box = document.getElementById('aiChatBox');
                box.removeChild(box.lastChild);
                appendAIMessage('bot', reply + `<br><span class="source-tag">Gemini API Connected</span>`);
            } catch (err) {
                const box = document.getElementById('aiChatBox');
                box.removeChild(box.lastChild);
                appendAIMessage('bot', `<span style="color:var(--accent-red);">تعذر الاتصال بمفتاح Gemini الخارجي، تم التبديل للمحرك السريري الداخلي تلقائياً.</span>`);
            }
        }

        function sendQuickPrompt(type) {
            if (type === 'audit_ward') {
                triggerAIPatientsAudit();
            } else if (type === 'audit_hd') {
                let report = "<strong><i class='fas fa-droplet'></i> تقرير تدقيق مرضى الغسل الكلوي:</strong><br><br>";
                hdPatientsList.forEach(p => {
                    report += `• <strong>${p.name}:</strong> ${p.aiAdvice}<br><br>`;
                });
                appendAIMessage('bot', report);
            } else if (type === 'triage_help') {
                appendAIMessage('bot', `<strong>معايير الفرز السريري السريع للطوارئ (ESI):</strong><br>• ESI 1 (أحمر): إنعاش فوري دون انتظار.<br>• ESI 2 (برتقالي): ألم صدر وصفي، اضطراب وعي، علامات صدمة.<br>• ESI 3 (أصفر): علامات حيوية متماسكة لكن يتطلب تحاليل وسونار.<br><span class="source-tag">ESI Triage</span>`);
            }
        }

        function triggerAIPatientsAudit() {
            if (!document.getElementById('aiPanel').classList.contains('open')) toggleAIPanel();
            appendAIMessage('user', 'تدقيق شامل لمرضى الردهة.');
            setTimeout(() => {
                let rep = "<strong><i class='fas fa-microchip'></i> تقرير التدقيق السريري:</strong><br><br>";
                patientsList.forEach(p => {
                    if (p.medications.toLowerCase().includes("propranolol") && p.pmhx.includes("ربو")) {
                        rep += `<span style="color:var(--accent-red); font-weight:800;">🚨 خطر: المريض ${p.name} مصاب بالربو ويأخذ Propranolol!</span><br>`;
                    } else {
                        rep += `• المريض ${p.name}: مؤشرات مستقرة.<br>`;
                    }
                });
                appendAIMessage('bot', rep);
            }, 400);
        }

        /* ========================================================
           10. التهيئة الأولية عند التشغيل
           ======================================================== */
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('overlay').classList.toggle('active');
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('.sidebar-menu button').forEach(btn => btn.classList.remove('active'));

            const targetTab = document.getElementById(tabId);
            if (targetTab) targetTab.classList.add('active');

            const activeBtn = Array.from(document.querySelectorAll('.sidebar-menu button')).find(b => b.getAttribute('onclick').includes(tabId));
            if (activeBtn) activeBtn.classList.add('active');

            if (tabId === 'tab-admin' && !isAdminUnlocked) {
                document.getElementById('adminLockScreen').style.display = 'block';
                document.getElementById('adminUnlockedContent').style.display = 'none';
            }

            toggleSidebar();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        document.addEventListener('DOMContentLoaded', () => {
            renderDynamicSidebar();
            applyBannerSettings();
            applyAISettings();
            renderERTriageList();
            renderHDPatientsList();
            renderPatientsList();
            buildActilyseChecklist();
            buildCTChecklist();
            populatePediatricDropdown();
            renderERDrugs();
            renderIraqiDrugs();
            runGCSCalculation();
            runHeartCalculation();
        });
    </script>
