            e.preventDefault();
            const name = document.getElementById('tr-name').value.trim();
            const age = parseInt(document.getElementById('tr-age').value);
            const cc = document.getElementById('tr-cc').value.trim();
            const bp = document.getElementById('tr-bp').value.trim();
            const hr = parseInt(document.getElementById('tr-hr').value);
            const rr = parseInt(document.getElementById('tr-rr').value);
            const spo2 = parseInt(document.getElementById('tr-spo2').value);
            const gcs = parseInt(document.getElementById('tr-gcs').value);
            const pain = parseInt(document.getElementById('tr-pain').value);
            const redflags = document.getElementById('tr-redflags').value;

            let level = 3;
            let levelTitle = "Level 3: Urgent (حاد ومستقر)";
            let badgeClass = "esi-3";
            let rationale = "العلامات الحيوية مستقرة نسبياً، يتطلب موارد تشخيصية وعلاجية متعددة.";
            let action = "حجز وريدي، سحب تحاليل دم، مراقبة العلامات الحيوية كل 30 دقيقة.";

            if (redflags === 'cardiac_arrest' || gcs <= 8 || spo2 < 85 || hr < 40 || hr > 160) {
                level = 1;
                levelTitle = "Level 1: Resuscitation (إنعاش فوري)";
                badgeClass = "esi-1";
                rationale = "حالة مهددة للحياة فوراً؛ خطر توقف تنفسي أو قلبي وشيك مع فشل عصبي أو دوراني حاد.";
