    <!-- منطق وتفاعلية JavaScript الكاملة -->
    <script>
        /* ========================================================
           1. إعدادات النظام وتخصيص القائمة والذكاء الاصطناعي
           ======================================================== */
        let toolsConfig = JSON.parse(localStorage.getItem('md_tools_config')) || [
            { id: 'tab-er-triage', title: 'فرز مرضى الطوارئ (AI Triage)', icon: 'fa-truck-medical', visible: true },
            { id: 'tab-hd-patients', title: 'مرضى الغسل الكلوي (Hemodialysis)', icon: 'fa-droplet', visible: true },
            { id: 'tab-patients', title: 'سجلات وتقييم مرضى الردهة', icon: 'fa-bed-pulse', visible: true },
            { id: 'tab-peds', title: 'حاسبة جرعات الأطفال بالوزن', icon: 'fa-baby', visible: true },
            { id: 'tab-er-drugs', title: 'دليل أدوية الطوارئ الشامل', icon: 'fa-pills', visible: true },
            { id: 'tab-iraqi-rx', title: 'صيدلية العراق (Iraqi Formulary)', icon: 'fa-prescription-bottle-medical', visible: true },
            { id: 'tab-actilyse', title: 'موانع دواء أكتيليز (Checklist)', icon: 'fa-ban', visible: true },
            { id: 'tab-head-ct', title: 'معايير مفراس الرأس (CT Brain)', icon: 'fa-x-ray', visible: true },
            { id: 'tab-gcs', title: 'حاسبة كلاسكو للغيبوبة (GCS)', icon: 'fa-brain', visible: true },
            { id: 'tab-heart', title: 'حاسبة Heart Score للصدر', icon: 'fa-heart-pulse', visible: true },
            { id: 'tab-admin', title: 'لوحة الإدارة والتحكم (محمية)', icon: 'fa-lock', visible: true }
        ];

        let systemConfig = {
            adminPin: localStorage.getItem('md_admin_pin') || '1234',
            wardTitle: localStorage.getItem('md_ward_title') || 'منظومة الطبيب الذكي الشاملة',
            bannerActive: localStorage.getItem('md_banner_active') !== 'false',
            bannerText: localStorage.getItem('md_banner_text') || 'تنبيه مناوبة عامة: يرجى التحقق من أجهزة الإنعاش ومطابقة الفرز الفوري.',
            bannerType: localStorage.getItem('md_banner_type') || 'banner-warning',
            aiEnabled: localStorage.getItem('md_ai_enabled') !== 'false',
            aiProvider: localStorage.getItem('md_ai_provider') || 'local',
            geminiApiKey: localStorage.getItem('md_gemini_key') || '',
            aiCustomEndpoint: localStorage.getItem('md_ai_custom_endpoint') || ''
        };

        let isAdminUnlocked = false;

        function renderDynamicSidebar() {
            const menu = document.getElementById('dynamicSidebarMenu');
            menu.innerHTML = '';
            toolsConfig.forEach(tool => {
                if (tool.visible) {
                    const li = document.createElement('li');
                    li.innerHTML = `<button onclick="switchTab('${tool.id}')"><i class="fas ${tool.icon}"></i> ${tool.title}</button>`;
                    menu.appendChild(li);
                }
            });
        }

        function renderToolsReorderManager() {
            const container = document.getElementById('toolsReorderList');
            container.innerHTML = '';
            toolsConfig.forEach((tool, index) => {
                const item = document.createElement('div');
                item.className = 'tool-order-item';
                item.innerHTML = `
                    <div style="display:flex; align-items:center; gap:0.6rem; flex-grow:1;">
                        <i class="fas ${tool.icon}" style="color:var(--primary); width:20px;"></i>
                        <input type="text" value="${tool.title}" onchange="updateToolTitle(${index}, this.value)" style="flex-grow:1; padding:0.4rem 0.6rem; border:1px solid var(--border); border-radius:6px; font-size:0.85rem;">
                    </div>
                    <div style="display:flex; align-items:center; gap:0.4rem;">
                        <label style="font-size:0.8rem; display:flex; align-items:center; gap:0.3rem;">
                            <input type="checkbox" ${tool.visible ? 'checked' : ''} onchange="toggleToolVisibility(${index}, this.checked)"> إظهار
                        </label>
                        <button class="btn btn-secondary" style="padding:0.3rem 0.6rem; font-size:0.75rem;" onclick="moveTool(${index}, -1)" ${index === 0 ? 'disabled' : ''}><i class="fas fa-arrow-up"></i></button>
                        <button class="btn btn-secondary" style="padding:0.3rem 0.6rem; font-size:0.75rem;" onclick="moveTool(${index}, 1)" ${index === toolsConfig.length - 1 ? 'disabled' : ''}><i class="fas fa-arrow-down"></i></button>
                    </div>
                `;
                container.appendChild(item);
            });
        }

        function updateToolTitle(index, newTitle) {
            toolsConfig[index].title = newTitle;
            localStorage.setItem('md_tools_config', JSON.stringify(toolsConfig));
            renderDynamicSidebar();
        }

        function toggleToolVisibility(index, isVisible) {
            toolsConfig[index].visible = isVisible;
            localStorage.setItem('md_tools_config', JSON.stringify(toolsConfig));
            renderDynamicSidebar();
        }

        function moveTool(index, direction) {
            const targetIndex = index + direction;
            if (targetIndex >= 0 && targetIndex < toolsConfig.length) {
                const temp = toolsConfig[index];
                toolsConfig[index] = toolsConfig[targetIndex];
                toolsConfig[targetIndex] = temp;
                localStorage.setItem('md_tools_config', JSON.stringify(toolsConfig));
                renderToolsReorderManager();
                renderDynamicSidebar();
            }
        }

        function saveSiteTitle() {
            const newTitle = document.getElementById('adminSiteTitleInput').value.trim();
            if (newTitle) {
                systemConfig.wardTitle = newTitle;
                localStorage.setItem('md_ward_title', newTitle);
                document.getElementById('headerWardTitle').innerText = newTitle;
                alert("تم تحديث اسم الموقع بنجاح!");
            }
        }

        /* ========================================================
           2. قفل لوحة الإدارة والتحكم
           ======================================================== */
        function checkAdminPin() {
            const input = document.getElementById('adminPinInput');
            const err = document.getElementById('pinErrorMsg');
            if (input.value === systemConfig.adminPin) {
                isAdminUnlocked = true;
                err.style.display = 'none';
                document.getElementById('adminLockScreen').style.display = 'none';
                document.getElementById('adminUnlockedContent').style.display = 'block';
                input.value = '';
                populateAdminFields();
            } else {
                err.style.display = 'block';
                input.value = '';
                input.focus();
            }
        }

        function lockAdminPanel() {
            isAdminUnlocked = false;
            document.getElementById('adminLockScreen').style.display = 'block';
            document.getElementById('adminUnlockedContent').style.display = 'none';
        }

        function switchAdminPane(paneId) {
            document.querySelectorAll('.admin-section-pane').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.admin-nav-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(paneId).classList.add('active');
            event.target.classList.add('active');
        }

        function populateAdminFields() {
            document.getElementById('adminBannerText').value = systemConfig.bannerText;
            document.getElementById('adminBannerType').value = systemConfig.bannerType;
            document.getElementById('adminBannerActive').value = systemConfig.bannerActive ? "true" : "false";
            document.getElementById('adminSiteTitleInput').value = systemConfig.wardTitle;
            document.getElementById('adminGeminiApiKeyInput').value = systemConfig.geminiApiKey;
            document.getElementById('adminAIEnabledSelect').value = systemConfig.aiEnabled ? "true" : "false";
            document.getElementById('adminAIProviderSelect').value = systemConfig.aiProvider;
            document.getElementById('adminAICustomEndpoint').value = systemConfig.aiCustomEndpoint;

            renderToolsReorderManager();
            renderActilyseAdminManager();
            renderCTAdminManager();
            togglePediatricFormFields();
        }

        function saveBannerConfig(e) {
            e.preventDefault();
            systemConfig.bannerText = document.getElementById('adminBannerText').value.trim();
            systemConfig.bannerType = document.getElementById('adminBannerType').value;
            systemConfig.bannerActive = document.getElementById('adminBannerActive').value === "true";

            localStorage.setItem('md_banner_text', systemConfig.bannerText);
            localStorage.setItem('md_banner_type', systemConfig.bannerType);
            localStorage.setItem('md_banner_active', systemConfig.bannerActive);

            applyBannerSettings();
            alert("تم حفظ وتطبيق البنر الإعلاني بنجاح!");
        }

        function saveAISettingsFromAdmin() {
            systemConfig.aiEnabled = document.getElementById('adminAIEnabledSelect').value === "true";
            systemConfig.aiProvider = document.getElementById('adminAIProviderSelect').value;
            systemConfig.geminiApiKey = document.getElementById('adminGeminiApiKeyInput').value.trim();
            systemConfig.aiCustomEndpoint = document.getElementById('adminAICustomEndpoint').value.trim();

            localStorage.setItem('md_ai_enabled', systemConfig.aiEnabled);
            localStorage.setItem('md_ai_provider', systemConfig.aiProvider);
            localStorage.setItem('md_gemini_key', systemConfig.geminiApiKey);
            localStorage.setItem('md_ai_custom_endpoint', systemConfig.aiCustomEndpoint);

            applyAISettings();
            alert("تم حفظ وتحديث إعدادات الذكاء الاصطناعي بنجاح!");
        }

        function applyAISettings() {
            const aiFab = document.getElementById('aiMainFabWidget');
            const aiBadge = document.getElementById('aiStatusBadge');
            if (systemConfig.aiEnabled) {
                aiFab.style.display = 'flex';
                aiBadge.innerText = systemConfig.aiProvider === 'gemini' ? 'الذكاء السريري (Gemini API) نشط' : 'الذكاء السريري الداخلي نشط';
                aiBadge.style.background = 'rgba(16, 185, 129, 0.15)';
                aiBadge.style.color = '#34d399';
            } else {
                aiFab.style.display = 'none';
                document.getElementById('aiPanel').classList.remove('open');
                aiBadge.innerText = 'الذكاء الاصطناعي معطل';
                aiBadge.style.background = 'rgba(239, 68, 68, 0.15)';
                aiBadge.style.color = '#f87171';
            }
        }

        function handleChangePin(e) {
            e.preventDefault();
            const oldPin = document.getElementById('oldPinInput').value;
            const newPin = document.getElementById('newPinInput').value;
            const confirmPin = document.getElementById('confirmNewPinInput').value;

            if (oldPin !== systemConfig.adminPin) {
                alert("الرمز الحالي غير صحيح!");
                return;
            }
            if (newPin.length < 4) {
                alert("الرمز يجب ألا يقل عن 4 أرقام!");
                return;
            }
            if (newPin !== confirmPin) {
                alert("الرمز الجديد غير متطابق!");
                return;
            }

            systemConfig.adminPin = newPin;
            localStorage.setItem('md_admin_pin', newPin);
            alert("تم تحديث رمز PIN بنجاح!");
            document.getElementById('oldPinInput').value = '';
            document.getElementById('newPinInput').value = '';
            document.getElementById('confirmNewPinInput').value = '';
        }

        function wipePatients(type) {
            if (type === 'ward') {
                if (confirm("هل تريد بالتأكيد حذف جميع مرضى الردهة؟")) {
                    patientsList = [];
                    localStorage.setItem('md_patients', JSON.stringify(patientsList));
                    renderPatientsList();
                    alert("تم حذف جميع مرضى الردهة.");
                }
            } else if (type === 'triage') {
                if (confirm("هل تريد بالتأكيد حذف جميع مرضى فرز الطوارئ؟")) {
                    erTriageList = [];
                    localStorage.setItem('md_triage_patients', JSON.stringify(erTriageList));
                    renderERTriageList();
                    alert("تم حذف جميع مرضى فرز الطوارئ.");
                }
            } else if (type === 'dialysis') {
                if (confirm("هل تريد بالتأكيد حذف جميع مرضى الغسل الكلوي؟")) {
                    hdPatientsList = [];
                    localStorage.setItem('md_hd_patients_list', JSON.stringify(hdPatientsList));
                    renderHDPatientsList();
                    alert("تم حذف جميع مرضى الغسل الكلوي.");
                }
            }
        }

        function wipeAllSystemData() {
            if (confirm("تحذير فائق: هذا الإجراء سيعيد ضبط المصنع ويمسح كافة المرضى والإعدادات. هل تود الاستمرار؟")) {
                localStorage.clear();
                location.reload();
            }
        }

        function applyBannerSettings() {
            const banner = document.getElementById('siteBanner');
            document.getElementById('headerWardTitle').innerText = systemConfig.wardTitle;
            if (systemConfig.bannerActive) {
                banner.className = `site-banner ${systemConfig.bannerType}`;
                document.getElementById('bannerText').innerText = systemConfig.bannerText;
                banner.style.display = 'flex';
            } else {
                banner.style.display = 'none';
            }
        }

        function dismissBanner() {
            document.getElementById('siteBanner').style.display = 'none';
        }

        /* ========================================================
