        function handleHDPatientSubmit(e) {
            e.preventDefault();
            const editId = document.getElementById('hd-edit-id').value;
            const name = document.getElementById('hd-name').value.trim();
            const schedule = document.getElementById('hd-schedule').value;
            const access = document.getElementById('hd-access').value;
            const dryWeight = parseFloat(document.getElementById('hd-dryweight').value);
            const preWeight = parseFloat(document.getElementById('hd-preweight').value);
            const bp = document.getElementById('hd-bp').value.trim();
            const k = parseFloat(document.getElementById('hd-k').value);
            const urea = parseFloat(document.getElementById('hd-urea').value);
            const cr = parseFloat(document.getElementById('hd-cr').value);
            const hb = parseFloat(document.getElementById('hd-hb').value);
            const ca = parseFloat(document.getElementById('hd-ca').value);
            const po4 = parseFloat(document.getElementById('hd-po4').value);

            let advice = "المؤشرات ملائمة للشروع بجلسة الغسل القياسية مع سحب السوائل الزائدة.";
            let decision = "Proceed Standard";
            const overload = preWeight - dryWeight;
            const caPo4Product = ca * po4;

            if (k >= 6.5) {
                advice = "خطر فرط بوتاسيوم مهدد للحياة! إعطاء Calcium Gluconate 10% IV فوراً قبل وخز الإبر، واستخدام حمام غسل 1K أو 0K.";
                decision = "Urgent Membrane Stabilization";
            } else if (overload > 4.0) {
                advice = `احتباس سوائل كبير (+${overload.toFixed(1)} L)؛ خطر هبوط الضغط الحاد (IDH) عند محاولة السحب السريع.`;
            }

            if (caPo4Product > 55) {
                advice += ` تنبيه: حاصل ضرب الكالسيوم والفوسفور (${caPo4Product.toFixed(1)}) مرتفع ويسبب تكلس الأوعية.`;
            }

            const pData = {
                id: editId ? parseInt(editId) : Date.now(),
                name, schedule, access, dryWeight, preWeight, bp, k, urea, cr, hb, ca, po4,
                aiDecision: decision, aiAdvice: advice
            };

            if (editId) {
                const idx = hdPatientsList.findIndex(x => x.id === parseInt(editId));
                hdPatientsList[idx] = pData;
            } else {
                hdPatientsList.unshift(pData);
            }

            localStorage.setItem('md_hd_patients_list', JSON.stringify(hdPatientsList));
            closeHDPatientModal();
            renderHDPatientsList();
            renderPatientsList();
            alert(`تم حفظ وتحديث بيانات مريض الغسل والتحاليل بنجاح!`);
        }

